<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.NovoProduto"
             Title="Novo Produto">

    <VerticalStackLayout Padding="20" Spacing="10">

        <Label Text="Descrição" FontSize="16" />
        <Entry x:Name="txtDescricao" Placeholder="Descrição" />

        <Label Text="Quantidade" FontSize="16" />
        <Entry x:Name="txtQuantidade" Placeholder="Quantidade" Keyboard="Numeric" />

        <Label Text="Preço" FontSize="16" />
        <Entry x:Name="txtPreco" Placeholder="Preço" Keyboard="Numeric" />
        <Button Text="Salvar"
                Clicked="OnSalvarClicked"
                BackgroundColor="#2196F3"
                TextColor="White"
                Margin="0,10,0,0" />

    </VerticalStackLayout>
</ContentPage>

