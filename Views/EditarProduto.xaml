<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.EditarProduto"
             Title="Editar Produto">
    <VerticalStackLayout Spacing="15" Padding="20">
        <Label Text="Editar Produto"
               FontSize="26"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <Label Text="Descrição" />
        <Entry x:Name="txtDescricao" Placeholder="Descrição" />

        <Label Text="Quantidade" />
        <Entry x:Name="txtQuantidade" Placeholder="Quantidade" Keyboard="Numeric" />

        <Label Text="Preço" />
        <Entry x:Name="txtPreco" Placeholder="Preço" Keyboard="Numeric" />

        <Button x:Name="btnSalvar"
                Text="Salvar Alterações"
                Clicked="OnSalvarClicked"
                BackgroundColor="DarkBlue"
                TextColor="White" />

        <Button x:Name="btnExcluir"
                Text="Excluir"
                Clicked="OnExcluirClicked"
                BackgroundColor="Red"
                TextColor="White" />
    </VerticalStackLayout>
</ContentPage>
