<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppMinhasCompras.Views.NovoProduto"
             Title="Novo Produto">
    <VerticalStackLayout Spacing="15" Padding="20">
        <Label Text="Cadastrar Produto"
               FontSize="26"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <Label Text="Descrição" />
        <Entry x:Name="txtDescricao" Placeholder="Digite a descrição" />

        <Label Text="Quantidade" />
        <Entry x:Name="txtQuantidade" Placeholder="Digite a quantidade" Keyboard="Numeric" />

        <Label Text="Preço" />
        <Entry x:Name="txtPreco" Placeholder="Digite o preço" Keyboard="Numeric" />

        <Button x:Name="btnSalvar"
                Text="Salvar"
                Clicked="OnSalvarClicked"
                BackgroundColor="DarkBlue"
                TextColor="White" />
    </VerticalStackLayout>
</ContentPage>

